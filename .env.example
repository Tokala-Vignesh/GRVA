# CloudSentinel AI — Environment Configuration Example
# Local-first configuration: All variables are optional and have safe local defaults.

# Local Backend Host and Port
CLOUDSENTINEL_HOST=127.0.0.1
CLOUDSENTINEL_PORT=8765

# Local Application Security Token (Auto-generated by Electron on startup)
# In standalone mode or dev mode, leave empty to auto-generate a random token.
CLOUDSENTINEL_TOKEN=

# Local Ollama URL (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Local Database Paths (Defaults to OS AppData directory if left empty)
CLOUDSENTINEL_DB_PATH=
LANGGRAPH_DB_PATH=

# Polling Intervals (in seconds)
DISCOVERY_INTERVAL_SECONDS=900
METRICS_INTERVAL_SECONDS=300
PRIVATE_HOST_INTERVAL_SECONDS=60
ALERT_INTERVAL_SECONDS=60
